# Database (PostgreSQL 16 via Prisma 7)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/event_committee?schema=public"

# Session / auth
# JANGAN pakai nilai contoh ini di production. Generate: openssl rand -hex 32
SESSION_SECRET="DEV-ONLY-CONTOH-BUKAN-SECRET-PRODUCTION"

# CORS allowlist (koma-separated, tanpa spasi di antaranya disarankan)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174"

# Server
PORT="4000"
NODE_ENV="development"

# Jumlah hop reverse proxy yang dipercaya untuk req.ip (rate limiting).
# 0 = akses langsung (default). Set 1 bila di balik satu nginx/Caddy/ALB.
TRUST_PROXY_HOPS="0"

# Storage (S3-compatible, OD-11) — semua opsional, tapi all-or-none.
# Kosongkan semua = storage tidak tersedia (rute evidence gagal closed,
# backend tetap nyala). Jangan hardcode credential/bucket.
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="event-committee-evidence"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_FORCE_PATH_STYLE="true"
