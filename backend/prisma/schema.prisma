// backend/prisma/schema.prisma
//
// Prisma ORM v7 — Event Committee Management System.
//
// Penting (Prisma 7):
// - Koneksi database diatur di `prisma.config.ts` (datasource.url dari env).
//   JANGAN menambahkan `url` di dalam blok `datasource` di bawah ini.
// - Fase 1 hanya menyertakan model `User` dan `Session`.
//   Entitas fase 4-5 (events, event_members, invitations, financial_transactions,
//   transaction_evidence, transaction_history, ledger_entries, audit_logs)
//   ditambahkan melalui migration SQL manual di `prisma/migrations/`, bukan
//   melalui schema.prisma pada Fase 1. Lihat `prisma/migrations/README.md`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  events              Event[]       @relation("EventCreatedBy")
  memberships         EventMember[]
  acceptedInvitations Invitation[]  @relation("AcceptedInvitations")

  @@map("users")
}

enum EventStatus {
  OPEN
  CLOSED
}

enum MemberRole {
  EVENT_CHAIR
  DIVISION_LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum InvitationRole {
  DIVISION_LEADER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model FinancialTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String            @map("event_id") @db.Uuid
  type         TransactionType
  category     String            @db.VarChar(50)
  description  String            @db.Text
  amount       Decimal           @db.Decimal(19, 2)
  currency     String            @default("IDR") @db.Char(3)
  status       TransactionStatus @default(DRAFT)
  submitter    EventMember       @relation("TransactionSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  submitterId  String            @map("submitter_id") @db.Uuid
  approver     EventMember?      @relation("TransactionApprover", fields: [approverId], references: [id], onDelete: Restrict)
  approverId   String?           @map("approver_id") @db.Uuid
  submittedAt  DateTime?         @map("submitted_at")
  approvedAt   DateTime?         @map("approved_at")
  paidAt       DateTime?         @map("paid_at")
  rejectReason String?           @map("reject_reason") @db.Text
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  history TransactionHistory[]
  ledger  LedgerEntry[]
  evidence TransactionEvidence[] @relation("TransactionEvidence")

  @@index([eventId, status], map: "financial_transactions_event_id_status_idx")
  @@index([eventId, type], map: "financial_transactions_event_id_type_idx")
  @@index([eventId, createdAt], map: "financial_transactions_event_id_created_at_idx")
  @@index([submitterId], map: "financial_transactions_submitter_id_idx")
  @@map("financial_transactions")
}

model TransactionEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  transaction    FinancialTransaction @relation("TransactionEvidence", fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId  String   @map("transaction_id") @db.Uuid
  fileKey        String   @unique @map("file_key") @db.Text
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  isPaymentProof Boolean  @default(false) @map("is_payment_proof")
  sensitive      Boolean  @default(false)
  uploadedBy     EventMember @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([transactionId], map: "transaction_evidence_transaction_id_idx")
  @@map("transaction_evidence")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  event     Event?   @relation("AuditLogs", fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String?  @map("event_id") @db.Uuid
  actor     EventMember @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(50)
  entityId  String   @map("entity_id") @db.Text
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId, createdAt], map: "audit_logs_event_id_created_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_type_entity_id_idx")
  @@map("audit_logs")
}

model TransactionHistory {
  id            String               @id @default(uuid()) @db.Uuid
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String               @map("transaction_id") @db.Uuid
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  changedBy     EventMember          @relation("TransactionHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)
  changedById   String               @map("changed_by_id") @db.Uuid
  note          String?              @db.Text
  createdAt     DateTime             @default(now())

  @@index([transactionId, createdAt], map: "transaction_history_transaction_id_created_at_idx")
  @@map("transaction_history")
}

model LedgerEntry {
  id              String               @id @default(uuid()) @db.Uuid
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String               @map("event_id") @db.Uuid
  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  transactionId   String               @map("transaction_id") @db.Uuid
  direction       LedgerDirection
  amount          Decimal              @db.Decimal(19, 2)
  postedAt        DateTime             @default(now()) @map("posted_at")
  postedBy        EventMember          @relation("LedgerPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedById      String               @map("posted_by_id") @db.Uuid
  reversalOf      LedgerEntry?         @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversalOfId    String?              @map("reversal_of") @db.Uuid
  reversedEntries LedgerEntry[]        @relation("LedgerReversal")
  narration       String?              @db.Text
  createdAt       DateTime             @default(now())

  @@index([eventId, postedAt], map: "ledger_entries_event_id_posted_at_idx")
  @@index([eventId, direction], map: "ledger_entries_event_id_direction_idx")
  @@map("ledger_entries")
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  event        Event            @relation("EventInvitations", fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String           @map("event_id") @db.Uuid
  email        String           @db.VarChar(255)
  role         InvitationRole
  parent       EventMember?     @relation("InvitationParent", fields: [parentId], references: [id], onDelete: Restrict)
  parentId     String?          @map("parent_id") @db.Uuid
  tokenHash    String           @unique @map("token_hash") @db.Char(64)
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedBy    EventMember      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  invitedById  String           @map("invited_by") @db.Uuid
  acceptedBy   User?            @relation("AcceptedInvitations", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedById String?          @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([eventId, email, status], map: "invitations_event_id_email_status_idx")
  @@map("invitations")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(150)
  slug        String      @unique @db.VarChar(180)
  description String?     @db.Text
  status      EventStatus @default(OPEN)
  createdBy   User        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String      @map("created_by") @db.Uuid
  closedAt    DateTime?   @map("closed_at")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members       EventMember[]
  invitations   Invitation[]           @relation("EventInvitations")
  transactions  FinancialTransaction[]
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]             @relation("AuditLogs")

  @@index([status], map: "events_status_idx")
  @@map("events")
}

model EventMember {
  id                    String                 @id @default(uuid()) @db.Uuid
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId               String                 @map("event_id") @db.Uuid
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                String                 @map("user_id") @db.Uuid
  role                  MemberRole
  parent                EventMember?           @relation("EventMemberTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              EventMember[]          @relation("EventMemberTree")
  invitationsAsParent   Invitation[]           @relation("InvitationParent")
  invitationsSent       Invitation[]           @relation("InvitationInviter")
  submittedTransactions FinancialTransaction[] @relation("TransactionSubmitter")
  approvedTransactions  FinancialTransaction[] @relation("TransactionApprover")
  historyEntries        TransactionHistory[]   @relation("TransactionHistoryActor")
  ledgerEntries         LedgerEntry[]          @relation("LedgerPostedBy")
  evidenceUploads       TransactionEvidence[]  @relation("EvidenceUploader")
  auditLogs             AuditLog[]             @relation("AuditLogActor")
  parentId              String?                @map("parent_id") @db.Uuid
  title                 String?                @db.VarChar(100)
  status                MemberStatus           @default(ACTIVE)
  joinedAt              DateTime               @default(now()) @map("joined_at")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([userId, eventId], map: "event_members_user_id_event_id_key")
  @@unique([eventId, id], map: "event_members_event_id_id_key")
  @@index([eventId, parentId], map: "event_members_event_id_parent_id_idx")
  @@index([eventId, status], map: "event_members_event_id_status_idx")
  @@index([eventId, role], map: "event_members_event_id_role_idx")
  @@map("event_members")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?   @db.Text
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("sessions")
}
